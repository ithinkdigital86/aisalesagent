# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Sourcing
APOLLO_API_KEY=

# Email sending
RESEND_API_KEY=
EMAIL_FROM=
# Signing secret for the Resend webhook endpoint (/api/webhooks/resend).
# Copy it from the webhook in the Resend dashboard; it starts with whsec_.
RESEND_WEBHOOK_SECRET=
# Public base URL for links inside outbound email (unsubscribe). No trailing slash.
NEXT_PUBLIC_APP_URL=

# Voice and SMS. Leave blank until DLT registration is through.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
VAPI_API_KEY=

# Protects the cron routes from public invocation
CRON_SECRET=
